# 运行期数据（账号凭证、会话快照、签到记录）
data/
bin/

# 本机实际配置（含代理地址、API Key）
cockpit.json

# Local credentials and environment configuration
.env
.env.*
!.env.example
*.pem
*.p12
*.pfx

# 构建产物
*.exe
*.test
*.out
build/bin/
build/wailsjs/
# Wails 资源随仓库提供（干净 clone 才能生成图标与打包）；安装器缓存不入库
build/windows/*
!build/windows/icon.ico
!build/windows/info.json
!build/windows/wails.exe.manifest
!build/windows/installer/
build/windows/installer/tmp/
!build/windows/installer/project.nsi
!build/windows/installer/wails_tools.nsh

# 前端依赖（构建产物 internal/web/dist 必须提交：headless 构建不跑 npm）
frontend/node_modules/
frontend/.vite/

# 本机验证、参考源码与临时目录（不入库）
.verify-*/
.smoke-data/
.preview-dist/
.playwright-cli/
.qoder-credits/
.ref/
.workbuddy/
# CLI / 测试跑出来的会话探测结果（{"found":false,...} 之类），属运行产物
output/
*.tmp

# 冒烟/审计临时产物：build/probe 里有账号加密副本，绝不能入库
build/probe/
build/src-*.txt
# Full reference checkouts are research material, never application source.
build/ref-*/
node_modules/

cmd/desktop/*.syso

# 像素回归的临时 diff（基线入库，diff 不入库）
docs/design/visual-diff/

# 发布产物（仅根目录；internal/web/dist 已删除）
/dist/

# 本机验证截图与记录（含本机信息，不入库）
docs/evidence/

# Local audit snapshots can contain machine paths, process details, and account data.
docs/STATUS-*.md

# 内部交接、审计与设计过程材料（不随公开仓库发布）
docs/internal/

# 竞品对标材料永不入库：含对第三方项目的实现级分析，只作本机参考。
# 明确列出文件名，避免将来有人把 docs/internal/ 挪回 docs/ 后顺带提交。

# 云同步的运行时状态与锁（正常落在 data/ 下，这里兜底防止落到仓库任意位置）
sync-state.json
sync-state.json.lock
conflicts-*.json

# 隔离构建目录与本地证据图（不入库）
mobile/android/build-verify/

# 隔离构建目录与本地证据图（不入库）
docs/assets/

# Android 发布签名材料绝不入库：keystore、properties、临时文件。
*.jks
*.keystore
signing.properties

# 站点提案草稿（非本仓交付物）
/docs/site-proposal/

# /website/ 是官网源码，已纳入版本管理，勿再忽略。
