{
  "name": "aether-cockpit-scripts",
  "private": true,
  "type": "module",
  "description": "开发/验收脚本的依赖（UI 冒烟用 playwright；不影响应用本身）",
  "scripts": {
    "ui-check": "node scripts/ui-check.mjs",
    "test:ui": "node --test scripts/ui-unit.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "ui:dev": "node scripts/ui-dev.mjs",
    "ui:audit": "node scripts/ui-audit.mjs",
    "ui:lint": "node scripts/lint-tokens.mjs",
    "ui:all": "node scripts/lint-tokens.mjs && node scripts/ui-audit.mjs && node scripts/ui-axe.mjs && node scripts/ui-check.mjs",
    "ui:axe": "node scripts/ui-axe.mjs",
    "ui:visual": "node scripts/ui-visual.mjs",
    "ui:visual:update": "node scripts/ui-visual.mjs --update",
    "ui:lighthouse": "node scripts/ui-lighthouse.mjs",
    "ui:cross": "node scripts/ui-cross-browser.mjs",
    "ui:profile": "node scripts/ui-profile.mjs",
    "ui:layout": "node scripts/ui-layout.mjs",
    "icon:build": "node scripts/build-icon.mjs",
    "font:build": "python scripts/build-font.py",
    "build:desktop": "bash scripts/build-desktop.sh"
  },
  "devDependencies": {
    "axe-core": "^4.14.0",
    "lighthouse": "^13.6.0",
    "pixelmatch": "^8.0.0",
    "playwright": "1.64.1",
    "pngjs": "^7.0.0",
    "svgo": "^4.1.0",
    "typescript": "^5.9.3"
  }
}
