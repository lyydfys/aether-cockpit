<?xml version="1.0" encoding="utf-8"?>
<!--
  品牌头像 / 图标（含背景）：逐元素还原 internal/web/ui2/assets/aether-cockpit.svg
  - 108×108 viewport，与 SVG 的 viewBox 一一对应；
  - 先画 rx=20 的 #F8F9FA 圆角背景（等于 SVG 里的 <rect rx="20">），再画完整图案；
  - 图案包含：气泡 #1A73E8、星芒 #FFFFFF、4 个青点（#CCFFFF ×2、#80FFFF ×2）、
    右下角「channel route」路由徽标（#FFFFFF 圆 + #13A99B 描边 1.7 / #1A73E8 连线 2.2 /
    节点圆 2.1、2.5、2.1）。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 圆角背景：rx = ry = 20，等价于 SVG 的 <rect width="108" height="108" rx="20" fill="#F8F9FA"/> -->
    <path
        android:fillColor="#FFF8F9FA"
        android:pathData="M20,0 H88 A20,20 0,0 1,108,20 V88 A20,20 0,0 1,88,108 H20 A20,20 0,0 1,0,88 V20 A20,20 0,0 1,20,0 Z" />

    <!-- 气泡主体 -->
    <path
        android:fillColor="#FF1A73E8"
        android:pathData="M54,20 C35.22,20 20,33.43 20,50 C20,59.39 24.87,67.76 32.22,73.19 L28,88 L43.55,83.33 C46.86,84.45 50.36,85 54,85 C72.78,85 88,71.57 88,55 C88,38.43 72.78,20 54,20 Z" />

    <!-- 四角星芒 -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M54,34 L57,47 L70,50 L57,53 L54,66 L51,53 L38,50 L51,47 Z" />

    <!-- 4 个青色点（品牌的一部分，不可省略） -->
    <path
        android:fillColor="#FFCCFFFF"
        android:pathData="M36,34.5 A3.5,3.5 0,1 1,36,41.5 A3.5,3.5 0,1 1,36,34.5 Z" />
    <path
        android:fillColor="#FFCCFFFF"
        android:pathData="M72,58.5 A3.5,3.5 0,1 1,72,65.5 A3.5,3.5 0,1 1,72,58.5 Z" />
    <path
        android:fillColor="#FF80FFFF"
        android:pathData="M42,65.5 A2.5,2.5 0,1 1,42,70.5 A2.5,2.5 0,1 1,42,65.5 Z" />
    <path
        android:fillColor="#FF80FFFF"
        android:pathData="M66,34 A2,2 0,1 1,66,38 A2,2 0,1 1,66,34 Z" />

    <!-- 路由徽标（channel route）：白色底圆 + 青色描边 -->
    <path
        android:fillColor="#FFFFFFFF"
        android:strokeColor="#FF13A99B"
        android:strokeWidth="1.7"
        android:pathData="M66,75 A11,11 0,1 1,88,75 A11,11 0,1 1,66,75 Z" />
    <!-- 连线 -->
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="#FF1A73E8"
        android:strokeWidth="2.2"
        android:strokeLineCap="round"
        android:pathData="M72.5,75 H81.5" />
    <!-- 左节点 -->
    <path
        android:fillColor="#FF13A99B"
        android:pathData="M70.4,75 A2.1,2.1 0,1 1,74.6,75 A2.1,2.1 0,1 1,70.4,75 Z" />
    <!-- 中节点 -->
    <path
        android:fillColor="#FF1A73E8"
        android:pathData="M74.5,75 A2.5,2.5 0,1 1,79.5,75 A2.5,2.5 0,1 1,74.5,75 Z" />
    <!-- 右节点 -->
    <path
        android:fillColor="#FF13A99B"
        android:pathData="M79.4,75 A2.1,2.1 0,1 1,83.6,75 A2.1,2.1 0,1 1,79.4,75 Z" />
</vector>
