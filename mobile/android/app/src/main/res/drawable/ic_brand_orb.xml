<?xml version="1.0" encoding="utf-8"?>
<!--
  球内专用紧凑版品牌图形（悬浮球 32dp 用）。
  来源：internal/web/ui2/assets/aether-cockpit.svg（108×108）

  与 ic_brand_mark 的区别（这正是"看着像 MCA"的原因）：mark 只保留气泡 + 星芒，
  而 MCA 的图标恰好也是蓝色气泡 + 星芒；所以这里**保留右下角的 channel-route 徽标**，
  它是与 MCA 区分开的关键。4 个青点在 32dp 下是脏点，按光学尺寸规则省略。

  徽标比例：整组用 <group scale=1.4 pivot=(77,75)> 放大 1.4 倍（定稿档位）。
  - 放大后徽标直径 = 22 × 1.4 = 30.8 单位 → 32dp 图标里约 9.1dp：
    1.0×（6.5dp）是糊点、1.7×（11.1dp）占图标 35% 会抢气泡主体，9dp 是"看得出圆形徽记、又不喧宾夺主"的档位；
  - 描边、连线、节点圆同步放大（1.7 → 2.38、2.2 → 3.08、2.1/2.5 → 2.94/3.5）；
  - 位置不变，仍贴右下（右缘 ≈ 92.4、下缘 ≈ 90.4，不出 108 画布）。
  保留徽标原始 pathData（未改坐标），放大只由 <group> 承担，便于和源 SVG 对照。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="32dp"
    android:height="32dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 气泡主体（与源 SVG 逐字符一致） -->
    <path
        android:fillColor="#FF1A73E8"
        android:pathData="M54,20 C35.22,20 20,33.43 20,50 C20,59.39 24.87,67.76 32.22,73.19 L28,88 L43.55,83.33 C46.86,84.45 50.36,85 54,85 C72.78,85 88,71.57 88,55 C88,38.43 72.78,20 54,20 Z" />

    <!-- 四角星芒（与源 SVG 逐字符一致） -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M54,34 L57,47 L70,50 L57,53 L54,66 L51,53 L38,50 L51,47 Z" />

    <!-- 右下角 channel-route 徽标：整体放大 1.4×，贴右下 -->
    <group
        android:pivotX="77"
        android:pivotY="75"
        android:scaleX="1.4"
        android:scaleY="1.4">

        <!-- 徽标底圆（源 r=11，stroke 1.7 → 放大后 ≈ 15.4 / 2.38） -->
        <path
            android:fillColor="#FFFFFFFF"
            android:strokeColor="#FF13A99B"
            android:strokeWidth="1.7"
            android:pathData="M66,75 A11,11 0,1 1,88,75 A11,11 0,1 1,66,75 Z" />

        <!-- 连线（源 2.2 → 放大后 ≈ 3.08） -->
        <path
            android:fillColor="@android:color/transparent"
            android:strokeColor="#FF1A73E8"
            android:strokeWidth="2.2"
            android:strokeLineCap="round"
            android:pathData="M72.5,75 H81.5" />

        <!-- 左节点（源 r=2.1 → 放大后 ≈ 2.94） -->
        <path
            android:fillColor="#FF13A99B"
            android:pathData="M70.4,75 A2.1,2.1 0,1 1,74.6,75 A2.1,2.1 0,1 1,70.4,75 Z" />

        <!-- 中节点（源 r=2.5 → 放大后 3.5） -->
        <path
            android:fillColor="#FF1A73E8"
            android:pathData="M74.5,75 A2.5,2.5 0,1 1,79.5,75 A2.5,2.5 0,1 1,74.5,75 Z" />

        <!-- 右节点（源 r=2.1 → 放大后 ≈ 2.94） -->
        <path
            android:fillColor="#FF13A99B"
            android:pathData="M79.4,75 A2.1,2.1 0,1 1,83.6,75 A2.1,2.1 0,1 1,79.4,75 Z" />
    </group>
</vector>
