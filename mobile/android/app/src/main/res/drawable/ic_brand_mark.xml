<!--
  品牌图形 · 小尺寸光学版（无背景，透明）：只保留「气泡 + 星芒」，108×108 viewport。

  为什么是简化版（图标光学尺寸规则）：
  - 权威源图 internal/web/ui2/assets/aether-cockpit.svg 里的路由徽标直径 22/108；
    显示尺寸 24–28dp 时只有 ~5.7dp，徽标内三个节点只有 ~1dp，4 个青点直径 ~1.8dp——
    画出来是一团脏点，而不是细节。所以 24–28dp 这一档**只留气泡 + 星芒**。
  - 完整版（含 4 个青点 + 路由徽标 + 圆角背景）在 ic_brand_avatar.xml，用于 ≥40dp 的大图位。

  简化只删元素、不动主体：气泡与星芒的 pathData 与源 SVG 逐字符一致，viewport 仍是 108。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="44dp"
    android:height="44dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 气泡主体（与源 SVG 逐字符一致） -->
    <path
        android:fillColor="#FF1A73E8"
        android:pathData="M54,20 C35.22,20 20,33.43 20,50 C20,59.39 24.87,67.76 32.22,73.19 L28,88 L43.55,83.33 C46.86,84.45 50.36,85 54,85 C72.78,85 88,71.57 88,55 C88,38.43 72.78,20 54,20 Z" />

    <!-- 四角星芒（与源 SVG 逐字符一致） -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M54,34 L57,47 L70,50 L57,53 L54,66 L51,53 L38,50 L51,47 Z" />
</vector>
